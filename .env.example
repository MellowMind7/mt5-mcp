# mt5-mcp configuration.
# Copy this to .env and fill it in, or just run install.bat which does it for you.
# .env holds credentials. It is in .gitignore and must stay there.

# --- Terminal ---------------------------------------------------------------
# Full path to terminal64.exe. install.bat finds this automatically.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Only needed when the terminal is NOT already logged in. If you leave the
# terminal open and signed in - which you have to anyway - these can stay empty.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Safety rail ------------------------------------------------------------
# Live trading is off by default. Turn it on deliberately or not at all.
# With this false, every write tool is blocked on a live account; reading works.
MT5_ALLOW_LIVE=false

# Largest lot size a single trade may use.
MT5_MAX_LOT=1.0

# Most percent of equity one trade may put at risk.
MT5_MAX_RISK_PERCENT=2.0

# Most positions open at the same time.
MT5_MAX_OPEN_POSITIONS=10

# Stop opening new positions once the day is down this much, in percent.
MT5_DAILY_LOSS_LIMIT_PERCENT=5.0

# Identifies trades opened by this server. Positions with a different magic
# number are left alone unless you pass include_foreign=true.
MT5_MAGIC=770001

# --- Backtesting ------------------------------------------------------------
# A backtest cannot share an installation with the terminal you have open, so
# install.bat makes a portable copy here. The path must contain NO SPACES:
# MetaTrader silently ignores a /config: path that has one.
MT5_TESTER_TERMINAL_PATH=C:\mt5tester\terminal64.exe
MT5_TESTER_TIMEOUT_SEC=900

# --- Optional accelerator ---------------------------------------------------
# MetaTrader build 6060 and above ships its own MCP server. When a key is set
# here, backtests and compiling use it because it is faster. Everything works
# without it. The key is in the terminal under Tools > Options > MCP.
MT5_NATIVE_MCP_KEY=
MT5_USE_NATIVE_MCP=true
MT5_NATIVE_MCP_TERMINAL_URL=http://127.0.0.1:22346/mcp
MT5_NATIVE_MCP_EDITOR_URL=http://127.0.0.1:22345/mcp

# --- Display ----------------------------------------------------------------
# Timestamps are returned in broker time, this timezone, and UTC.
MT5_TIMEZONE_DISPLAY=Europe/Berlin

MT5_LOG_LEVEL=INFO
MT5_LOG_DIR=
